{
  "openapi": "3.1.0",
  "info": {
    "title": "DST Builder",
    "description": "DST Builder 最小生成闭环 API（SPEC-DB-001 §11）",
    "version": "0.3.5"
  },
  "paths": {
    "/api/projects": {
      "post": {
        "summary": "Create Project",
        "description": "创建项目库；目录已是 Builder 项目时幂等打开（opened_existing=True，200）。",
        "operationId": "create_project_api_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/current": {
      "get": {
        "summary": "Get Current Project",
        "description": "读取项目、当前草稿、引导步骤、聚焦字段与诊断（只读，无副作用）。",
        "operationId": "get_current_project_api_projects_current_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/current/draft": {
      "patch": {
        "summary": "Patch Current Draft",
        "description": "带 base_updated_at 乐观并发保存草稿；返回字段级诊断。",
        "operationId": "patch_current_draft_api_projects_current_draft_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets": {
      "post": {
        "summary": "Create Asset",
        "description": "纳入并哈希一个模板资产（§11）：复制 → 校验 → 内容寻址落盘 → 入库。",
        "operationId": "create_asset_api_assets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetIntakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/{asset_id}/inspect": {
      "post": {
        "summary": "Inspect Asset",
        "description": "用匹配版本 CAD 读取可用布局（§11）；端口未接线时返回 501。\n\nPLAN-DB-001 Task 4 裁决：本任务只定义 LayoutInspection 端口，\n端口未接线固定 501 + CAD_VERSION_UNAVAILABLE；真实 CAD 布局读取\n由 Task 7 接线，本端点绝不伪造布局列表。",
        "operationId": "inspect_asset_api_assets__asset_id__inspect_post",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetInspectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetInspectionResponse"
                }
              }
            }
          },
          "501": {
            "description": "布局 inspection 端口未接线或匹配版本 CAD 不可用（CAD_VERSION_UNAVAILABLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cadabilities": {
      "get": {
        "summary": "Get Cadabilities",
        "description": "只读 capability 响应：两个受支持版本的探测结果（不启动进程）。",
        "operationId": "get_cadabilities_api_cadabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CadCapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans": {
      "post": {
        "summary": "Submit Plan",
        "description": "提交修订并产生预览计划（§5）：确定性 ID，不自动确认。",
        "operationId": "submit_plan_api_plans_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanSubmitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/confirm": {
      "post": {
        "summary": "Confirm Plan",
        "description": "用户显式确认计划（绝不自动确认）；确认后构建输入冻结。",
        "operationId": "confirm_plan_api_plans__plan_id__confirm_post",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanConfirmationResponse"
                }
              }
            }
          },
          "404": {
            "description": "计划不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "409": {
            "description": "PLAN_STALE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "存在阻断诊断",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/builds": {
      "post": {
        "summary": "Start Build",
        "description": "基于已确认计划创建 build/attempt 并在线程执行器中启动构建。",
        "operationId": "start_build_api_builds_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuildStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "计划不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "409": {
            "description": "PLAN_STALE / PACKAGE_TARGET_EXISTS / BUILD_ALREADY_RUNNING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "PLAN_NOT_CONFIRMED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/builds/{build_id}/cancel": {
      "post": {
        "summary": "Cancel Build",
        "description": "请求安全取消（§6）：检查点处迁移 CANCELLED；PUBLISHING 拒绝。",
        "operationId": "cancel_build_api_builds__build_id__cancel_post",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Build Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "构建不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "409": {
            "description": "PUBLISHING 或终止状态不响应取消（CANCEL_NOT_ACCEPTED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/builds/{build_id}": {
      "get": {
        "summary": "Get Build",
        "description": "读取状态、诊断和成果（§11）。",
        "operationId": "get_build_api_builds__build_id__get",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Build Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "构建不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/builds/{build_id}/handoff": {
      "post": {
        "summary": "Handoff Build",
        "description": "调用本机 Manager 交接适配器（§10/§11）：已发布成果包原样保留。",
        "operationId": "handoff_build_api_builds__build_id__handoff_post",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Build Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandoffResponse"
                }
              }
            }
          },
          "404": {
            "description": "构建不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "409": {
            "description": "构建未成功发布（HANDOFF_INVALID）或包冲突（HANDOFF_ID_CONFLICT）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "Manager 验证拒绝（HANDOFF_INVALID）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "502": {
            "description": "本机 Manager 不可用（HANDOFF_UNAVAILABLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/builds/{build_id}/events": {
      "get": {
        "summary": "Stream Build Events",
        "description": "SSE 事件流与重放（§6）：Last-Event-ID 之后的事件按序重放。",
        "operationId": "stream_build_events_api_builds__build_id__events_get",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Build Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 事件流（id: attempt:sequence）",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "构建不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPayloadModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetInspectRequest": {
        "properties": {
          "cad_version": {
            "type": "string",
            "enum": [
              "2016",
              "2020"
            ],
            "title": "Cad Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cad_version"
        ],
        "title": "AssetInspectRequest",
        "description": "POST /api/assets/{id}/inspect 请求：指定匹配版本的 CAD。"
      },
      "AssetInspectionResponse": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "cad_version": {
            "type": "string",
            "title": "Cad Version"
          },
          "layouts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Layouts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id",
          "cad_version",
          "layouts"
        ],
        "title": "AssetInspectionResponse",
        "description": "布局 inspection 结果；端口未接线时端点返回 501 错误负载。"
      },
      "AssetIntakeRequest": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "base",
              "layout"
            ],
            "title": "Role"
          },
          "source_path": {
            "type": "string",
            "title": "Source Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "source_path"
        ],
        "title": "AssetIntakeRequest",
        "description": "POST /api/assets 请求：纳入一个本机源文件（ Builder 为本地应用，\n源文件经路径引用而非 HTTP 上传，避免 2 GiB 文件流经接口层）。"
      },
      "AssetModel": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "relative_path": {
            "type": "string",
            "title": "Relative Path"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "relative_path",
          "sha256",
          "size",
          "source_name"
        ],
        "title": "AssetModel",
        "description": "纳入结果：内容寻址相对路径与固定哈希（§3 assets 表投影）。"
      },
      "BuildAttemptModel": {
        "properties": {
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt",
          "status",
          "progress"
        ],
        "title": "BuildAttemptModel",
        "description": "单个 attempt 的状态投影（历史不覆盖）。"
      },
      "BuildStartRequest": {
        "properties": {
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan_id"
        ],
        "title": "BuildStartRequest",
        "description": "POST /api/builds 请求：基于已确认计划创建 build/attempt。"
      },
      "BuildStatusResponse": {
        "properties": {
          "build_id": {
            "type": "string",
            "title": "Build Id"
          },
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "published_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published Path"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/BuildAttemptModel"
            },
            "type": "array",
            "title": "Attempts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "build_id",
          "plan_id",
          "attempt",
          "status",
          "progress",
          "created_at",
          "attempts"
        ],
        "title": "BuildStatusResponse",
        "description": "GET /api/builds/{id}、POST /api/builds、POST .../cancel 响应。"
      },
      "CadCapabilitiesResponse": {
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/CadCapabilityModel"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "capabilities"
        ],
        "title": "CadCapabilitiesResponse",
        "description": "GET /api/cadabilities 响应：两个受支持版本的探测结果。"
      },
      "CadCapabilityModel": {
        "properties": {
          "cad_version": {
            "type": "string",
            "title": "Cad Version"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "console_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Console Path"
          },
          "plugin_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plugin Path"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cad_version",
          "available"
        ],
        "title": "CadCapabilityModel",
        "description": "单个 CAD 版本的只读能力探测结果。"
      },
      "DiagnosticModel": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          }
        },
        "additionalProperties": false,
