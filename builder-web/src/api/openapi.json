{
  "openapi": "3.1.0",
  "info": {
    "title": "DST Builder",
    "description": "DST Builder 最小生成闭环 API（SPEC-DB-001 §11）",
    "version": "0.3.5"
  },
  "paths": {
    "/api/projects": {
      "post": {
        "summary": "Create Project",
        "description": "创建项目库（project.dstb）、初始草稿与 assets/、builds/ 目录。",
        "operationId": "create_project_api_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/current": {
      "get": {
        "summary": "Get Current Project",
        "description": "读取项目、当前草稿、引导步骤、聚焦字段与诊断（只读，无副作用）。",
        "operationId": "get_current_project_api_projects_current_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/current/draft": {
      "patch": {
        "summary": "Patch Current Draft",
        "description": "带 base_updated_at 乐观并发保存草稿；返回字段级诊断。",
        "operationId": "patch_current_draft_api_projects_current_draft_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectStateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets": {
      "post": {
        "summary": "Create Asset",
        "description": "纳入并哈希一个模板资产（§11）：复制 → 校验 → 内容寻址落盘 → 入库。",
        "operationId": "create_asset_api_assets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetIntakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/{asset_id}/inspect": {
      "post": {
        "summary": "Inspect Asset",
        "description": "用匹配版本 CAD 读取可用布局（§11）；端口未接线时返回 501。\n\nPLAN-DB-001 Task 4 裁决：本任务只定义 LayoutInspection 端口，\n端口未接线固定 501 + CAD_VERSION_UNAVAILABLE；真实 CAD 布局读取\n由 Task 7 接线，本端点绝不伪造布局列表。",
        "operationId": "inspect_asset_api_assets__asset_id__inspect_post",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetInspectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetInspectionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cadabilities": {
      "get": {
        "summary": "Get Cadabilities",
        "description": "只读 capability 响应：两个受支持版本的探测结果（不启动进程）。",
        "operationId": "get_cadabilities_api_cadabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CadCapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetInspectRequest": {
        "properties": {
          "cad_version": {
            "type": "string",
            "enum": [
              "2016",
              "2020"
            ],
            "title": "Cad Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cad_version"
        ],
        "title": "AssetInspectRequest",
        "description": "POST /api/assets/{id}/inspect 请求：指定匹配版本的 CAD。"
      },
      "AssetInspectionResponse": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "cad_version": {
            "type": "string",
            "title": "Cad Version"
          },
          "layouts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Layouts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id",
          "cad_version",
          "layouts"
        ],
        "title": "AssetInspectionResponse",
        "description": "布局 inspection 结果；端口未接线时端点返回 501 错误负载。"
      },
      "AssetIntakeRequest": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "base",
              "layout"
            ],
            "title": "Role"
          },
          "source_path": {
            "type": "string",
            "title": "Source Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "source_path"
        ],
        "title": "AssetIntakeRequest",
        "description": "POST /api/assets 请求：纳入一个本机源文件（ Builder 为本地应用，\n源文件经路径引用而非 HTTP 上传，避免 2 GiB 文件流经接口层）。"
      },
      "AssetModel": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "relative_path": {
            "type": "string",
            "title": "Relative Path"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "relative_path",
          "sha256",
          "size",
          "source_name"
        ],
        "title": "AssetModel",
        "description": "纳入结果：内容寻址相对路径与固定哈希（§3 assets 表投影）。"
      },
      "CadCapabilitiesResponse": {
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/CadCapabilityModel"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "capabilities"
        ],
        "title": "CadCapabilitiesResponse",
        "description": "GET /api/cadabilities 响应：两个受支持版本的探测结果。"
      },
      "CadCapabilityModel": {
        "properties": {
          "cad_version": {
            "type": "string",
            "title": "Cad Version"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "console_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Console Path"
          },
          "plugin_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plugin Path"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cad_version",
          "available"
        ],
        "title": "CadCapabilityModel",
        "description": "单个 CAD 版本的只读能力探测结果。"
      },
      "DiagnosticModel": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "title": "DiagnosticModel"
      },
      "DraftFieldsModel": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "project": {
            "$ref": "#/components/schemas/ProjectFieldsModel"
          },
          "numbering": {
            "$ref": "#/components/schemas/NumberingFieldsModel"
          },
          "cad_version": {
            "type": "string",
            "title": "Cad Version"
          },
          "sheets": {
            "items": {
              "$ref": "#/components/schemas/SheetFieldsModel"
            },
            "type": "array",
            "title": "Sheets"
          },
          "template": {
            "$ref": "#/components/schemas/TemplateFieldsModel"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "numbering",
          "cad_version",
          "sheets",
          "template"
        ],
        "title": "DraftFieldsModel",
        "description": "§4 DraftProjectV1 JSON 形态（PATCH 载荷的解析与校验目标）。"
      },
      "DraftPatchRequest": {
        "properties": {
          "base_updated_at": {
            "type": "string",
            "title": "Base Updated At"
          },
          "draft": {
            "$ref": "#/components/schemas/DraftFieldsModel"
          },
          "wizard_step": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Wizard Step"
          },
          "focused_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focused Field"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_updated_at",
          "draft",
          "wizard_step"
        ],
        "title": "DraftPatchRequest",
        "description": "PATCH /api/projects/current/draft 请求：base_updated_at 乐观并发。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NumberingFieldsModel": {
        "properties": {
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "start": {
            "type": "integer",
            "title": "Start"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prefix",
          "start",
          "width"
        ],
        "title": "NumberingFieldsModel"
      },
      "ProjectCreateRequest": {
        "properties": {
          "project_root": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Root"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "discipline": {
            "type": "string",
            "title": "Discipline"
          },
          "output_path": {
            "type": "string",
            "title": "Output Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "stage",
          "discipline",
          "output_path"
        ],
        "title": "ProjectCreateRequest",
        "description": "POST /api/projects 请求。``project_root`` 仅在应用工厂未绑定根目录时必填。"
      },
      "ProjectFieldsModel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "discipline": {
            "type": "string",
            "title": "Discipline"
          },
          "output_path": {
            "type": "string",
            "title": "Output Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "stage",
          "discipline",
          "output_path"
        ],
        "title": "ProjectFieldsModel"
      },
      "ProjectModel": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "discipline": {
            "type": "string",
            "title": "Discipline"
          },
          "output_path": {
            "type": "string",
            "title": "Output Path"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "stage",
          "discipline",
          "output_path",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectModel"
      },
      "ProjectStateResponse": {
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectModel"
          },
          "draft": {
            "$ref": "#/components/schemas/DraftFieldsModel"
          },
          "wizard_step": {
            "type": "integer",
            "title": "Wizard Step"
          },
          "focused_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focused Field"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/DiagnosticModel"
            },
            "type": "array",
            "title": "Diagnostics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "draft",
          "wizard_step",
          "focused_field",
          "updated_at",
          "diagnostics"
        ],
        "title": "ProjectStateResponse",
        "description": "GET /api/projects/current 与 PATCH /api/projects/current/draft 响应。"
      },
      "SheetFieldsModel": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "SheetFieldsModel"
      },
      "TemplateFieldsModel": {
        "properties": {
          "base_asset_id": {
            "type": "string",
            "title": "Base Asset Id"
          },
          "layout_asset_id": {
            "type": "string",
            "title": "Layout Asset Id"
          },
          "source_layout": {
            "type": "string",
            "title": "Source Layout"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_asset_id",
          "layout_asset_id",
          "source_layout"
        ],
        "title": "TemplateFieldsModel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
